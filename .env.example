# hub-mcp configuration. MCP clients normally pass these through their `env` block;
# for local development you can export them in your shell. Never commit real values.

# Base URL of the hub this server drives. No trailing slash.
#   e.g. https://hub.example.com   or   http://localhost:3000
HUB_BASE_URL=

# Bearer token for the hub's /api/internal/mcp/* routes. Must equal the hub's own
# HUB_MCP_TOKEN (set in the hub's environment or its Settings → Integrations store).
HUB_MCP_TOKEN=

# Local kill switch: "true" makes every write tool refuse at the confirm step.
# Bypassable by anyone holding the token — the authoritative switch is
# HUB_MCP_WRITES_ENABLED on the hub itself.
HUB_MCP_READONLY=false

# Optional IANA timezone used when a tool call omits one. Default: America/Los_Angeles.
HUB_DEFAULT_TIMEZONE=
